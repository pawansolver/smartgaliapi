# Server configuration
PORT=3000
NODE_ENV=development

# Database configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=ecommerce_db

# JWT configuration
JWT_SECRET=super_secret_jwt_key_for_ecommerce
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_with_a_distinct_random_secret_of_at_least_32_characters
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=30d
AUTH_SESSION_TTL=10m

# SMTP configuration for OTP email delivery
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=no-reply@example.com
EMAIL_PASS=replace_with_smtp_password

# Comma-separated browser origins. Use explicit HTTPS origins in production.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PUBLIC_API_ORIGIN=http://localhost:3000
PUBLIC_MEDIA_ORIGIN=http://localhost:3000

# Set to the reverse-proxy hop count or proxy subnet in production.
TRUST_PROXY=false

# Production deployments must mount this path on persistent storage.
UPLOADS_PATH=./uploads

# Redis (idempotency, Socket.IO adapter, BullMQ)
# REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=smartgali:

# BullMQ chat-events queue (prefix must differ from REDIS_KEY_PREFIX)
QUEUE_PREFIX=smartgali:bull
CHAT_QUEUE_NAME=chat-events
CHAT_WORKER_CONCURRENCY=10
CHAT_JOB_ATTEMPTS=5
CHAT_JOB_BACKOFF=2000
OUTBOX_PUBLISH_BATCH=50

# Distributed rate limiting (Redis-backed when Redis is available)
RATE_LIMIT_ENABLED=true
# Prefix applied inside RedisStore (final key: ${REDIS_KEY_PREFIX}${RATE_LIMIT_KEY_PREFIX}<policy>:...)
RATE_LIMIT_KEY_PREFIX=ratelimit:

# Redis-down policy: local_fallback (default) | fail_open (explicit opt-in)
# Security-sensitive (signin/OTP/signup/reset) uses stricter emergencyMax under local_fallback.
RATE_LIMIT_REDIS_FAILURE_MODE_SECURITY=local_fallback
RATE_LIMIT_REDIS_FAILURE_MODE_GENERAL=local_fallback

RATE_LIMIT_GENERAL_WINDOW_MS=60000
RATE_LIMIT_GENERAL_MAX=300

RATE_LIMIT_MESSAGE_WINDOW_MS=60000
RATE_LIMIT_MESSAGE_MAX=60

RATE_LIMIT_UPLOAD_WINDOW_MS=300000
RATE_LIMIT_UPLOAD_MAX=20

RATE_LIMIT_SEARCH_WINDOW_MS=60000
RATE_LIMIT_SEARCH_MAX=30

RATE_LIMIT_REACTION_WINDOW_MS=60000
RATE_LIMIT_REACTION_MAX=120

RATE_LIMIT_MESSAGE_ACTION_WINDOW_MS=60000
RATE_LIMIT_MESSAGE_ACTION_MAX=120

RATE_LIMIT_AUTH_SIGNUP_WINDOW_MS=3600000
RATE_LIMIT_AUTH_SIGNUP_MAX=10
RATE_LIMIT_AUTH_SIGNUP_EMERGENCY_MAX=3
RATE_LIMIT_AUTH_OTP_SEND_WINDOW_MS=900000
RATE_LIMIT_AUTH_OTP_SEND_MAX=5
RATE_LIMIT_AUTH_OTP_SEND_EMERGENCY_MAX=2
RATE_LIMIT_AUTH_OTP_VERIFY_WINDOW_MS=900000
RATE_LIMIT_AUTH_OTP_VERIFY_MAX=10
RATE_LIMIT_AUTH_OTP_VERIFY_EMERGENCY_MAX=3
RATE_LIMIT_AUTH_SIGNIN_WINDOW_MS=900000
RATE_LIMIT_AUTH_SIGNIN_MAX=10
RATE_LIMIT_AUTH_SIGNIN_EMERGENCY_MAX=3
RATE_LIMIT_AUTH_RESET_WINDOW_MS=900000
RATE_LIMIT_AUTH_RESET_MAX=10
RATE_LIMIT_AUTH_RESET_EMERGENCY_MAX=3
RATE_LIMIT_AUTH_REFRESH_WINDOW_MS=60000
RATE_LIMIT_AUTH_REFRESH_MAX=30
RATE_LIMIT_AUTH_REFRESH_EMERGENCY_MAX=10

# Real Redis multi-instance IT (npm run test:ratelimit:redis)
# RATE_LIMIT_TEST_REDIS_URL=
# RATE_LIMIT_TEST_REDIS_PORT=6379
# RATE_LIMIT_TEST_KEY_PREFIX=test:ratelimit:

# Firebase Cloud Messaging (Phase 6) — never commit real private keys
FCM_ENABLED=false
FCM_NOTIFICATION_ENABLED=true
FCM_SKIP_ONLINE_USERS=true
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
# Use \n for newlines in the PEM private key
FCM_PRIVATE_KEY=
FCM_INTEGRATION_TEST=false
# Opt-in real device smoke (never commit tokens):
# FCM_TEST_DEVICE_TOKEN=
# FCM_TEST_INVALID_TOKEN=
# FCM_DEVICE_DELIVERY_CONFIRMED=false

# Presence heartbeat TTL (seconds) for multi-instance stale-online protection
PRESENCE_TTL_SECONDS=90
