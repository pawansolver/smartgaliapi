{
  "name": "enterprise-nodejs-boilerplate",
  "version": "1.0.0",
  "description": "Enterprise eCommerce Boilerplate with Node.js, Express, Sequelize, and ES6 Modules",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "setup:profile": "node scripts/setupProfileModule.js",
    "migrate:profile:up": "node scripts/migrateProfile.js up",
    "migrate:profile:down": "node scripts/migrateProfile.js down",
    "migrate:chat:up": "node scripts/migrateChat.js up",
    "migrate:chat:down": "node scripts/migrateChat.js down",
    "migrate:auth:up": "node scripts/migrateAuth.js up",
    "migrate:auth:down": "node scripts/migrateAuth.js down",
    "test": "node --test"
  },
  "keywords": [
    "nodejs",
    "express",
    "sequelize",
    "mysql",
    "boilerplate"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "joi": "^17.13.4",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.6.5",
    "nodemailer": "^9.0.3",
    "sequelize": "^6.35.1",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
