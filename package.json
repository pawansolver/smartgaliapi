{
  "name": "enterprise-nodejs-boilerplate",
  "version": "1.0.0",
  "description": "Enterprise eCommerce Boilerplate with Node.js, Express, Sequelize, and ES6 Modules",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "load:seed": "node src/tests/load/scripts/seed_load_test_data.js",
    "load:seed:cleanup": "node src/tests/load/scripts/seed_load_test_data.js --cleanup",
    "load:feed:small": "artillery run src/tests/load/configs/feed_small.yml --output src/tests/load/results/small.json",
    "load:feed:medium": "artillery run src/tests/load/configs/feed_medium.yml --output src/tests/load/results/medium.json",
    "load:feed:large": "artillery run src/tests/load/configs/feed_large.yml --output src/tests/load/results/large.json",
    "load:feed:stress": "artillery run src/tests/load/configs/feed_stress.yml --output src/tests/load/results/stress.json",
    "load:feed:cache": "artillery run src/tests/load/configs/feed_cache_cold_warm.yml --output src/tests/load/results/cache.json",
    "load:feed:concurrency": "node src/tests/load/scripts/concurrency_race_test.js",
    "load:feed:failure": "node src/tests/load/scripts/failure_recovery_test.js",
    "load:feed:all": "node src/tests/load/run_benchmarks.js",
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "worker": "node src/workers/index.js",
    "worker:dev": "nodemon src/workers/index.js",
    "setup:profile": "node scripts/setupProfileModule.js",
    "migrate:profile:up": "node scripts/migrateProfile.js up",
    "migrate:profile:down": "node scripts/migrateProfile.js down",
    "migrate:chat:up": "node scripts/migrateChat.js up",
    "migrate:chat:down": "node scripts/migrateChat.js down",
    "migrate:auth:up": "node scripts/migrateAuth.js up",
    "migrate:auth:down": "node scripts/migrateAuth.js down",
    "migrate:community:up": "node scripts/migrateCommunity.js up",
    "migrate:community:down": "node scripts/migrateCommunity.js down",
    "test": "node --test \"test/*.test.js\"",
    "test:ratelimit:redis": "node --test \"test/integration/rateLimit.redis.integration.test.js\"",
    "test:presence:redis": "node --test \"test/integration/presence.redis.integration.test.js\"",
    "test:fcm:integration": "node --test \"test/integration/fcm.integration.test.js\""
  },
  "keywords": [
    "nodejs",
    "express",
    "sequelize",
    "mysql",
    "boilerplate"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "bcrypt": "^5.1.1",
    "bullmq": "^6.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.6.0",
    "firebase-admin": "^13.10.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.11.1",
    "joi": "^17.13.4",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "mysql2": "^3.6.5",
    "nodemailer": "^9.0.3",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.1",
    "sequelize": "^6.35.1",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.0",
    "xss": "^1.0.15"
  },
  "devDependencies": {
    "artillery": "^2.0.34",
    "nodemon": "^3.0.2",
    "redis-memory-server": "^0.17.1"
  }
}
