{
  "watch": [
    "src"
  ],
  "ext": "js,json",
  "ignore": [
    "uploads/**",
    "logs/**",
    "*.log",
    "test/**",
    "node_modules/**",
    "coverage/**",
    "*.pdf",
    "*.md",
    "scripts/**"
  ],
  "nodeArgs": [
    "--max-old-space-size=4096",
    "--max-semi-space-size=64"
  ],
  "delay": 1000
}